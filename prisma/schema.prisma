// Monetira — Prisma Schema
// Database: Neon PostgreSQL
// Auth: Auth.js (NextAuth) with Google OAuth
//
// Minimum identity foundation:
//   User, Account (OAuth), Session, VerificationToken
//   Subscription (linked to User)
//   AiUsage (linked to User, week-scoped)
//
// Financial data (transactions, savings, etc.) remains in localStorage
// during this migration phase. Phase H documents the migration path.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// AUTH.JS REQUIRED MODELS
// Exact field names required by @auth/prisma-adapter
// https://authjs.dev/getting-started/adapters/prisma
// ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts      Account[]
  sessions      Session[]
  subscription  Subscription?
  aiUsage       AiUsage[]

  @@map("users")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

// ─────────────────────────────────────────────
// SUBSCRIPTION
// Linked to authenticated User.
// Eliminates client-trusted subscription state.
// ─────────────────────────────────────────────

model Subscription {
  id        String   @id @default(cuid())
  userId    String   @unique
  plan      String   @default("FREE") // "FREE" | "PRO"
  status    String   @default("active") // "active" | "cancelled" | "expired" | "pending"
  startedAt DateTime @default(now())
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("subscriptions")
}

// ─────────────────────────────────────────────
// AI USAGE
// User-scoped, week-scoped quota tracking.
// Replaces client-trusted localStorage ai_usage.
// ─────────────────────────────────────────────

model AiUsage {
  id         String   @id @default(cuid())
  userId     String
  weekStart  DateTime // Start of ISO week (Monday 00:00:00 UTC)
  chatCount  Int      @default(0)
  parseCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@index([userId])
  @@map("ai_usage")
}
